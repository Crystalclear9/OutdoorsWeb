# Copy to .env and replace these administrator values before starting.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_123
# Host port used by Docker Compose; container API port stays 3001.
APP_PORT=8080
PORT=3001
HOST=0.0.0.0
DB_PATH=./data/app.sqlite
# Set to true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Optional exact browser origins, comma-separated. Same-origin needs no value.
PUBLIC_ORIGIN=
# Exact IP addresses of reverse proxies directly trusted by this service.
# Leave blank for direct access. Proxies must append or overwrite X-Forwarded-For correctly.
TRUSTED_PROXY_IPS=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
MIN_FREE_DISK_MB=256
# Maintenance process deadline, renewable lease, and graceful termination wait.
MAINTENANCE_TIMEOUT_SECONDS=1800
MAINTENANCE_LEASE_SECONDS=120
MAINTENANCE_KILL_GRACE_SECONDS=5
# Capacity warnings include DB/WAL/SHM and every regular backup-tree file.
# 0 disables that warning; thresholds never authorize file deletion.
DATABASE_WARNING_MB=2048
BACKUP_WARNING_MB=10240
# Optional approximate admission limits, 0 keeps disabled. Reads/reviews stay available.
DATABASE_MAX_MB=0
BACKUP_MAX_MB=0
# History retention is preview-only unless enabled AND a category has days > 0.
# Days: 0 keeps forever; otherwise 30-36500. Audit/referenced images stay protected.
HISTORY_RETENTION_ENABLED=false
HISTORY_RETENTION_BATCH=200
ARCHIVE_RETENTION_DAYS=0
DELIVERY_RETENTION_DAYS=0
UNREAD_NOTIFICATION_RETENTION_DAYS=0
# Require staff to enroll before using administrative functions.
REQUIRE_ADMIN_MFA=true
ARCHIVE_AFTER_DAYS=365
# Optional 64 hex characters. If blank, a key is created at data/.mfa-key.
APP_ENCRYPTION_KEY=
# Public HTTPS root URL for OAuth (without a trailing path).
PUBLIC_URL=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
# Twilio SMS + voice; enable the destination country and approved sender first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VOICE=Polly.Zhiyu
# S3-compatible encrypted off-machine backup. Use a private bucket with lifecycle rules.
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=us-east-1
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BACKUP_PREFIX=outdoors/
S3_PATH_STYLE=false
S3_ALLOW_HTTP=false
# Independent 64 hex character key; retain an offline copy for restore.
BACKUP_ENCRYPTION_KEY=
# Generic JSON webhook, optional Bearer token and HMAC-SHA256 signing secret.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_SECRET=
# Run the independent monitor on another device with this public health URL.
MONITOR_URL=
